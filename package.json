{
    "name": "event-volunteer-qr",
    "private": true,
    "type": "module",
    "scripts": {
        "postinstall": "npx prisma generate --schema=backend/prisma/schema.prisma && npm --prefix frontend install --no-fund --no-audit",
        "dev": "node --watch backend/src/server.js",
        "build": "npm --prefix frontend run build",
        "start": "node backend/src/server.js",
        "prisma:generate": "npx prisma generate --schema=backend/prisma/schema.prisma",
        "prisma:migrate": "cd backend && npx prisma migrate deploy"
    },
    "dependencies": {
        "@prisma/client": "^5.17.0",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.21.2",
        "express-validator": "^7.3.2",
        "jsonwebtoken": "^9.0.3",
        "mysql2": "^3.23.3",
        "prisma": "^5.17.0",
        "qrcode": "^1.5.4"
    }
}
